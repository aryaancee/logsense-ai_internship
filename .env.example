# Copy to ".env". NEVER commit or share .env. On a hosting service, enter these as environment variables instead of using a file.

# --- required on a server -------------------------------------------------------
# Long random text used to sign logins and encrypt users' cloud keys. Create one with:
#   python -c "import secrets;print(secrets.token_hex(32))"
LOGSENSE_SECRET=
# Set to 1 when deployed (the Dockerfile already does). Turns off docs pages, never uses the server's own cloud access, adds HSTS.
# LOGSENSE_HOSTED=1

# --- AI provider (pick ONE; without a key the app still works with basic answers) -
LOGSENSE_PROVIDER=auto          # auto | gemini | anthropic | openai | ollama | none
# OpenAI-compatible example (Groq):
# LOGSENSE_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# LOGSENSE_MODEL=openai/gpt-oss-120b
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://localhost:11434

# --- limits (protect the shared AI key and your disk) ---------------------------
# LOGSENSE_GUEST_AI_LIMIT=10    AI questions per day for demo accounts
# LOGSENSE_USER_AI_LIMIT=50     AI questions per day for registered accounts
# LOGSENSE_MAX_UPLOAD_MB=10
# LOGSENSE_MAX_LOGS=100000      stored log lines per account (oldest are dropped)

# --- optional --------------------------------------------------------------------
# LOGSENSE_AUTHOR=Your Name     shown on the landing page footer
# LOGSENSE_DATA=data            where accounts and databases are stored (mount a persistent disk here)
# SLACK_WEBHOOK_URL=
# LOGSENSE_LIVE=1               0 = turn off the background live poller
# LOGSENSE_AUTH=on              "off" = single-user mode without login (local testing only, never on a server)
# LOGSENSE_ALLOW_FILE_SOURCE=0  1 = allow "local log file" sources on a server
# LOGSENSE_MAX_LLM=0            0 = label log patterns with built-in rules (saves AI quota)
